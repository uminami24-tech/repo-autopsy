# Repo Autopsy — 環境変数サンプル（実値は絶対にコミットしないでください）
# このファイルをコピーして .env を作成し、実際の値を設定してください。
# cp .env.example .env

# ── LLM API ──────────────────────────────────────────────────────────────────
# OpenAI 互換 API のエンドポイント（既定: https://zro.moonmath.ai/v1）
OPENAI_BASE_URL=

# API キー（OPENAI_API_KEY または ZRO_API_KEY のどちらかを設定してください）
# 優先順: OPENAI_API_KEY → ZRO_API_KEY
OPENAI_API_KEY=
ZRO_API_KEY=

# 使用するモデル名（既定: deepseek-v4.1-flash）
AUTOPSY_MODEL=

# ── GitHub API ────────────────────────────────────────────────────────────────
# GitHub Personal Access Token（省略可。未設定時は 60 req/h の制限あり）
GITHUB_TOKEN=
